			"command": "java",
			"args": [
				"-Djava.awt.headless=true",
				"-cp",
				"/opt/Fiji.app/jars/*:/opt/Fiji.app/plugins/*:/workspace/fiji-devel/ST2WSI_Registration/target/ST2WSI_Registration-2.6.14-SNAPSHOT.jar",
