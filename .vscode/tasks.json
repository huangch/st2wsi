{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-st2wsi",
			"type": "shell",
			"command": "mvn",
			"args": [
				"clean",
				"package"
			],
			"isBackground": false
		},
		{
			"label": "build-st2wsi-after-cli-fix",
			"type": "shell",
			"command": "mvn",
			"args": [
				"clean",
				"package"
			],
			"isBackground": false
		},
		{
			"label": "check-run-st2wsi-script",
			"type": "shell",
			"command": "bash",
			"args": [
				"-n",
				"run_st2wsi.sh"
			],
			"isBackground": false
		},
		{
			"label": "build-st2wsi-after-arg-format-fix",
