			"type": "shell",
			"command": "/opt/Fiji.app/ImageJ-linux64",
			"args": [
				"--help"
			],
			"isBackground": false
		},
		{
			"label": "lint-run-script-ij1",
			"type": "shell",
			"command": "bash",
			"args": [
				"-n",
				"run_st2wsi.sh"
			],
			"isBackground": false
		},
		{
			"label": "test-st2wsi-cli-current",
			"type": "shell",
			"command": "./run_st2wsi.sh",
			"args": [
				"-o",
				"/workspace/spie2027/data/Human_Breast_Biomarkers_S1_Top_outs",
				"-r",
				"/workspace/spie2027/data/Human_Breast_Biomarkers_S1_Top_outs/morphology_focus/ch0000_dapi.ome.tif",
				"-t",
				"/workspace/spie2027/data/Human_Breast_Biomarkers_S1_Top_he_image.ome.tif"
			],
			"isBackground": false
		},
		{
			"label": "imagej-dry-run",
			"type": "shell",
			"command": "/opt/Fiji.app/ImageJ-linux64",
			"args": [
				"--dry-run",
				"--headless",
				"--ij1",
				"--run",
				"st2wsi_registration.ST2WSI_Registration",
				"outputDir=/tmp refImagePath=/tmp/a tgtImagePath=/tmp/b refSeries=3 tgtSeries=3 refFlipped=false refRotated=90 tgtChannel=Hematoxylon"
			],
			"isBackground": false
		},
