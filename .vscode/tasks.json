				"outputDir=/tmp/st2wsi-test refImagePath=/tmp/notfound_dapi.tif tgtImagePath=/tmp/notfound_he.tif refSeries=3 tgtSeries=3 refFlipped=false refRotated=90 tgtChannel=Hematoxylon"
			],
			"isBackground": false
		},
