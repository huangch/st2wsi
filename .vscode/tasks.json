				"refRotated=90",
				"tgtChannel=Hematoxylon"
			],
			"isBackground": false
		},
		{
			"label": "st2wsi-mainclass-arg-test",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"java -Djava.awt.headless=true -cp /opt/Fiji.app/jars/*:/opt/Fiji.app/plugins/*:/workspace/fiji-devel/ST2WSI_Registration/target/ST2WSI_Registration-2.6.14-SNAPSHOT.jar st2wsi_registration.ST2WSI_Registration \"outputDir=/tmp/st2wsi-test refImagePath=/tmp/notfound_dapi.tif tgtImagePath=/tmp/notfound_he.tif refSeries=3 tgtSeries=3 refFlipped=false refRotated=90 tgtChannel=Hematoxylon\""
			],
			"isBackground": false
		},
