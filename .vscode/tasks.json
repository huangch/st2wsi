			"command": "mvn",
			"args": [
				"clean",
				"package"
			],
			"isBackground": false
		},
		{
			"label": "lint-run-script-after-argfix",
			"type": "shell",
			"command": "bash",
			"args": [
				"-n",
				"run_st2wsi.sh"
			],
			"isBackground": false
		},
		{
